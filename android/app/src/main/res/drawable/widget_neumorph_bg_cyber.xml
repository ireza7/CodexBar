<?xml version="1.0" encoding="utf-8"?>
<!-- Neumorphic extruded card background (Cyber Glow theme) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#080A10" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1.2dp"
                android:color="#00E5FF" />
            <solid android:color="#121520" />
        </shape>
    </item>
    <item
        android:left="1.2dp"
        android:top="1.2dp"
        android:right="2.2dp"
        android:bottom="2.2dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:angle="135"
                android:startColor="#181C2B"
                android:centerColor="#131622"
                android:endColor="#0F111B"
                android:type="linear" />
            <stroke
                android:width="0.5dp"
                android:color="#1F2A3E" />
        </shape>
    </item>
</layer-list>
