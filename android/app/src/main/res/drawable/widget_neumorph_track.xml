<?xml version="1.0" encoding="utf-8"?>
<!-- Neumorphic sunken progress track -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#0A0B10" />
            <stroke
                android:width="0.8dp"
                android:color="#06070A" />
        </shape>
    </item>
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="5.5dp" />
            <solid android:color="#0D0E14" />
            <stroke
                android:width="0.5dp"
                android:color="#1A1C24" />
        </shape>
    </item>
</layer-list>
