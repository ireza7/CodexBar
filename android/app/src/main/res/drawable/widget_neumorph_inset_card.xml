<?xml version="1.0" encoding="utf-8"?>
<!-- Neumorphic sunken (concave) card for model quotas -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark inset shadow base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="#12131A" />
            <stroke
                android:width="1dp"
                android:color="#0B0C10" />
        </shape>
    </item>

    <!-- Subtle bottom reflection stroke giving depth -->
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="12.5dp" />
            <stroke
                android:width="0.8dp"
                android:color="#242836" />
            <solid android:color="#14161F" />
        </shape>
    </item>
</layer-list>
