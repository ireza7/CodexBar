<?xml version="1.0" encoding="utf-8"?>
<!-- Neumorphic extruded card background (Slate Steel theme) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#10131A" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#3B4459" />
            <solid android:color="#232734" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:angle="135"
                android:startColor="#282D3C"
                android:centerColor="#222633"
                android:endColor="#1C202B"
                android:type="linear" />
            <stroke
                android:width="0.5dp"
                android:color="#47526D" />
        </shape>
    </item>
</layer-list>
